def screen_height():
    """Pixels on the monitor the dock will open on, or a sane guess."""
    try:
        monitors = Gdk.Display.get_default().get_monitors()
        if monitors.get_n_items():
            return monitors.get_item(0).get_geometry().height
    except (AttributeError, TypeError):
        pass
    return 1080


# -------------------------------------------------------------------- view --
class WindowMap:
    def __init__(self, config):
        self.config = config
        self.position = config["position"]
        self.locked = bool(config["locked"])
        # On a side the workspaces stack down the screen; along the top or
        # bottom they run across it.
        self.vertical = self.position in ("left", "right")
        self.pending = 0
        self.hide_timer = 0
        self.out = False
        self.printers = []
        self.scanners = []
        self.links = {}
        self.scanned_at = 0
        self.device_note = ""
        self.scanning = False
        self.looking = False
        self.scan_options = {}       # device -> what the backend offers
        self.scan_status = {}        # device -> what its sensors say
        self.scan_started = 0.0      # when the running scan began
        self.button_was_down = {}    # device -> was its Scan button down
        self.printer_status = {}     # printer -> what its queue reports
        self.drives = []             # disks, grouped by the thing you plug in
        self.drive_busy = set()      # paths with an operation in flight
        self.ejected = dict(config.get("ejected") or {}) \
            if isinstance(config.get("ejected"), dict) else {}
                                   # path -> what was ejected, and when
        self.drive_note = ""         # what the last mount or eject reported
        self.drive_pending = 0       # debounce timer for a burst of udev
        self.section_state = None    # what the pinned sections last drew
        self.layout = None           # which windows sat where, last redraw
        self.chips = {}              # address -> (title label, chip box)
        self.tray_buttons = {}       # the status icons along the bottom
        self.clock_label = None

        edges = Gtk4LayerShell.Edge
        anchor = {"left": edges.LEFT, "right": edges.RIGHT,
                  "top": edges.TOP, "bottom": edges.BOTTOM}[self.position]

        self.window = Gtk.Window()
        self.window.add_css_class("panel")
        Gtk4LayerShell.init_for_window(self.window)
        Gtk4LayerShell.set_layer(self.window, Gtk4LayerShell.Layer.TOP)
        Gtk4LayerShell.set_anchor(self.window, anchor, True)
        if self.vertical:
            # Span the full height so it reads as a dock, not a floating card.
            Gtk4LayerShell.set_anchor(self.window, edges.TOP, True)
            Gtk4LayerShell.set_anchor(self.window, edges.BOTTOM, True)
            self.window.set_size_request(config["width"], -1)
        else:
            Gtk4LayerShell.set_margin(self.window, anchor, 18)
        if self.locked:
            # Reserve the strip: tiled windows end beside the dock instead of
            # underneath it. A popped-in dock deliberately reserves nothing,
            # so showing it never reshuffles the windows you are looking at.
            Gtk4LayerShell.auto_exclusive_zone_enable(self.window)
        # Pointer only: with keyboard focus the dock would become the focused
        # window and the focus line would only ever name itself.
        Gtk4LayerShell.set_keyboard_mode(
            self.window, Gtk4LayerShell.KeyboardMode.NONE)
        if hasattr(Gtk4LayerShell, "set_namespace"):
            Gtk4LayerShell.set_namespace(self.window, "hypr-windows")

        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        body.add_css_class("panel-body")
        if self.vertical:
            # The surface is full height because it is anchored top and
            # bottom; without this the card paints only as tall as its
            # content while still reserving the whole strip.
            body.set_vexpand(True)
            body.set_valign(Gtk.Align.FILL)
        self.window.set_child(body)
        self.body = body

        body.append(self.build_settings_row())

        focus_line = Gtk.Box(
            orientation=(Gtk.Orientation.VERTICAL if self.vertical
                         else Gtk.Orientation.HORIZONTAL),
            spacing=(2 if self.vertical else 8))
        focus_line.add_css_class("focus-line")
        label = Gtk.Label(label="FOCUS", xalign=0.0)
        label.add_css_class("focus-label")
        focus_line.append(label)
        self.focus_title = Gtk.Label(label="-", xalign=0.0)
        self.focus_title.add_css_class("focus-title")
        self.focus_title.set_ellipsize(3)  # PANGO_ELLIPSIZE_END
        self.focus_title.set_max_width_chars(28 if self.vertical else 70)
        self.focus_title.set_wrap(self.vertical)
        self.focus_title.set_lines(2 if self.vertical else 1)
        focus_line.append(self.focus_title)
        body.append(focus_line)

        self.columns = Gtk.Box(
            orientation=(Gtk.Orientation.VERTICAL if self.vertical
                         else Gtk.Orientation.HORIZONTAL),
            spacing=(6 if self.vertical else 8))
        self.devices_box = None
        self.drives_box = None
        if self.vertical:
            # A long window list scrolls rather than pushing the dock off the
            # bottom of the screen.
            scroller = Gtk.ScrolledWindow(vexpand=True)
            scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            scroller.set_child(self.columns)
            body.append(scroller)
            if config["drives"] or config["devices"]:
                # Pinned below the scroller, so the drives and printers stay
                # put however many windows are open instead of scrolling out
                # of reach. It scrolls on its own once it is crowded: the
                # window list above gives up its space first, but four
                # drives, a printer and a scanner will still run off the
                # bottom of the screen, and whatever lands there is not
                # merely ugly - it is unreachable.
                body.append(Gtk.Separator(
                    orientation=Gtk.Orientation.HORIZONTAL))
                bottom = Gtk.Box(orientation=Gtk.Orientation.VERTICAL,
                                 spacing=5)
                pinned = Gtk.ScrolledWindow()
                pinned.set_policy(Gtk.PolicyType.NEVER,
                                  Gtk.PolicyType.AUTOMATIC)
                pinned.set_propagate_natural_height(True)
                pinned.set_max_content_height(int(screen_height() * 0.55))
                pinned.set_child(bottom)
                body.append(pinned)
                if config["drives"]:
                    self.drives_box = Gtk.Box(
                        orientation=Gtk.Orientation.VERTICAL, spacing=5)
                    bottom.append(self.drives_box)
                if config["devices"]:
                    self.devices_box = Gtk.Box(
                        orientation=Gtk.Orientation.VERTICAL, spacing=5)
                    bottom.append(self.devices_box)
        else:
            body.append(self.columns)

        body.append(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL))
        body.append(self.build_tray())

        colors = palette()
        sheet = css(colors)
        if config["ws_colors"]:
            sheet += ws_css(colors)
        provider = Gtk.CssProvider()
        provider.load_from_data(sheet.encode())
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        # Unlocked, the dock withdraws when the pointer leaves it.
        motion = Gtk.EventControllerMotion()
        motion.connect("enter", lambda *_: self.pop_in())
        motion.connect("leave", lambda *_: self.start_hide())
        self.window.add_controller(motion)

        self.window.present()
        self.refresh()
        if not self.locked:
            # Pop-in: the dock stays mapped and slides off the edge on a
            # negative margin, leaving a few pixels peeking. One surface that
            # never unmaps, so the pointer always has something to touch -
            # a separate hair-thin trigger window refused to map at all next
            # to a hidden dock, and an unmapped dock cannot catch a pointer.
            self.slide_out()
        if os.environ.get("HYPR_WINDOWS_DEBUG"):
            print("position=%s locked=%s slid_out=%s visible=%s"
                  % (self.position, self.locked, self.out,
                     self.window.get_visible()), flush=True)

    # -- settings -----------------------------------------------------------
    def build_settings_row(self):
        """Where the dock lives, and whether it stays, set from the dock."""
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        row.add_css_class("settings-row")
        for position, label in (("left", "L"), ("right", "R"),
                                ("top", "T"), ("bottom", "B")):
            button = Gtk.Button(label=label)
            button.set_tooltip_text("dock on the %s" % position)
            if position == self.position:
                button.add_css_class("chosen")
            button.connect("clicked", self.on_position, position)
            row.append(button)

        spacer = Gtk.Box(hexpand=True)
        row.append(spacer)

        drives = Gtk.Button(label="DRV")
        drives.set_tooltip_text("show disks and sticks at the end")
        if self.config["drives"]:
            drives.add_css_class("chosen")
        drives.connect(
            "clicked",
            lambda *_: self.restart({"drives": not self.config["drives"]}))
        row.append(drives)

        devices = Gtk.Button(label="DEV")
        devices.set_tooltip_text("show printers and scanners at the end")
        if self.config["devices"]:
            devices.add_css_class("chosen")
        devices.connect(
            "clicked",
            lambda *_: self.restart({"devices": not self.config["devices"]}))
        row.append(devices)

        lock = Gtk.Button(label="LOCKED" if self.locked else "POP-IN")
        lock.set_tooltip_text(
            "locked: always here, windows tile beside it\n"
            "pop-in: hidden until the pointer touches the %s edge"
            % self.position)
        if self.locked:
            lock.add_css_class("chosen")
        lock.connect("clicked", self.on_lock)
        row.append(lock)
        return row

    def on_position(self, _button, position):
        self.restart({"position": position})

    def on_lock(self, _button):
        self.restart({"locked": not self.locked})

    def restart(self, changes):
        """Persist a setting and come back up with it.

        Anchors, the exclusive zone and the layout orientation are all fixed
        when the surface is built, so settling them by restarting is simpler
        and more predictable than mutating a live layer surface.
        """
        config = dict(self.config)
        config.update(changes)
        save_config(config)
        os.execv(sys.executable,
                 [sys.executable, os.path.abspath(__file__), "--no-toggle"])

    # -- pop-in -------------------------------------------------------------
    def edge_margin(self, pixels):
        edges = Gtk4LayerShell.Edge
        anchor = {"left": edges.LEFT, "right": edges.RIGHT,
                  "top": edges.TOP, "bottom": edges.BOTTOM}[self.position]
        Gtk4LayerShell.set_margin(self.window, anchor, pixels)

    def slide_out(self):
        """Park the dock off the edge with a sliver left to touch."""
        if self.locked:
            return
        thickness = (self.config["width"] if self.vertical
                     else self.window.get_allocated_height() or 230)
        self.edge_margin(-(thickness - max(2, self.config["trigger_px"])))
        self.out = True

    def pop_in(self):
        self.cancel_hide()
        if self.out:
            self.refresh()
            self.edge_margin(0)
            self.out = False

    def start_hide(self):
        if self.locked:
            return
        self.cancel_hide()
        self.hide_timer = GLib.timeout_add(
            self.config["hide_delay_ms"], self.hide_now)

    def cancel_hide(self):
        if self.hide_timer:
            GLib.source_remove(self.hide_timer)
            self.hide_timer = 0

    def hide_now(self):
        self.hide_timer = 0
        self.slide_out()
        return False

    def toggle_visible(self):
        """SIGUSR1, so a keybind or a bar button can show it without a relaunch."""
        if self.locked:
            return
        if self.out:
            self.pop_in()
        else:
            self.hide_now()

    # -- data ---------------------------------------------------------------
    def refresh_windows(self):
        """What a compositor event changes: the window map, nothing else.

        Hyprland sends a windowtitle event every time any title changes, and
        a terminal with a clock or an FPS counter in its title sends ten a
        second. Rebuilding the drives and printers on each one destroyed the
        widget under the pointer mid-click, so most presses on them never
        became a click at all - the section headings looked simply broken.
        """
        return self.refresh(sections=False)

    def refresh(self, sections=True):
        self.pending = 0
        clients = hypr_json("clients") or []
        monitors = hypr_json("monitors") or []
        active_ids, active_special = set(), set()
        for monitor in monitors:
            workspace = monitor.get("activeWorkspace") or {}
            if workspace.get("id") is not None:
                active_ids.add(workspace["id"])
            special = monitor.get("specialWorkspace") or {}
            if special.get("name"):
                active_special.add(special["name"].replace("special:", ""))

        focused = hypr_json("activewindow") or {}
        focused_address = focused.get("address")
        if focused.get("title"):
            self.focus_title.set_text(
                "%s  -  %s" % (focused.get("class") or "?", focused["title"]))
        else:
            self.focus_title.set_text("(nothing focused)")

        # Group by workspace: normal ones by id, special ones by their short
        # name, so a window parked in a special workspace stays visible.
        grouped = {}
        for client in clients:
            workspace = client.get("workspace") or {}
            name = str(workspace.get("name", ""))
            if name.startswith("special:"):
                key = name.replace("special:", "")
            elif workspace.get("id") is not None:
                key = workspace["id"]
            else:
                continue
            grouped.setdefault(key, []).append(client)

        occupied = {k for k in grouped if isinstance(k, int)}
        if self.config["all_workspaces"]:
            keys = sorted(set(BASE_WORKSPACES) | occupied | active_ids)
        else:
            # Only workspaces that hold something, plus the one you are on.
            keys = sorted(occupied | active_ids)
            # ...and one spare, so there is still somewhere to drag a window
            # to start a new workspace. Without it, hiding the empty ones
            # would take the feature away.
            spare = next(n for n in range(1, 100)
                         if n not in occupied and n not in active_ids)
            keys.append(spare)
        keys += sorted(k for k in grouped if isinstance(k, str))

        # Which windows are where, ignoring what they are called. If only
        # the titles moved, the chips are still the right chips: relabel
        # them where they stand rather than building new ones, so a click
        # in progress survives.
        signature = (tuple(str(k) for k in keys), focused_address,
                     tuple(sorted(active_ids)), tuple(sorted(active_special)),
                     tuple(tuple(c.get("address") for c in grouped.get(k, []))
                           for k in keys))
        if signature == self.layout and self.chips:
            for client in clients:
                entry = self.chips.get(client.get("address"))
                if entry is None:
                    continue
                label, chip = entry
                title = str(client.get("title") or "")
                if label.get_text() != title:
                    label.set_text(title)
                    chip.set_tooltip_text(
                        "%s\n%s\n\nclick to go to it, drag to a workspace, "
                        "X to close" % (client.get("class") or "?", title))
            if sections:
                self.refresh_sections()
            return
        self.layout = signature
        self.chips = {}

        child = self.columns.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            self.columns.remove(child)
            child = nxt
        for key in keys:
            self.columns.append(self.build_section(
                key, grouped.get(key, []), active_ids, active_special,
                focused_address))
        if sections:
            self.refresh_sections()

    def drawn_drives(self):
        """The drives as the cards show them, free space already rounded."""
        return [(g["path"], g["bus"], g["model"], g["kind"], g["removable"],
                 g["can_power_off"],
                 [(v["path"], v["label"], v["fstype"], v["size"], v["mount"],
                   v["extra_mounts"], v["readonly"], v["system"],
                   v["protected"],
                   round(100.0 * (v["used"] or 0) / v["fssize"])
                   if v["mount"] and v["fssize"] else None,
                   hypr_devices.human(v["avail"]) if v["mount"] else None)
                  for v in g["volumes"]])
                for g in self.drives]

    def refresh_sections(self):
        """Rebuild the pinned sections - only when their own state moves.

        The polls are the point: the CUPS queue is re-read every 15s and
        the disks every 30s, and nearly every time they find exactly what
        they found before. Rebuilding on an unchanged answer destroys the
        widget under the pointer for nothing, and a click that straddles
        the rebuild never becomes a click.

        The pinned boxes are what make skipping safe. Along the top or
        bottom the sections live in `columns`, which a window redraw has
        just emptied, so there they must always be built again.
        """
        pinned = self.drives_box is not None or self.devices_box is not None
        state = repr((
            self.drawn_drives(), self.printers, self.printer_status,
            self.links, self.scanners,
            # Sensor dictionaries jitter and free space changes with every
            # write; neither moves what is on the card. Compare what is
            # drawn, or the guard never holds.
            {d: (v.get("text"), v.get("ready"))
             for d, v in self.scan_status.items()},
            self.device_note, self.drive_note, self.looking, self.scanning,
            sorted(self.drive_busy), self.profile(),
            [self.config[k] for k in ("drives", "drives_open", "drives_fixed",
                                      "devices", "devices_open")]))
        if pinned and state == self.section_state:
            return
        self.section_state = state
        if self.config["drives"]:
            self.fill(self.drives_box, self.build_drives())
        if self.config["devices"]:
            self.fill(self.devices_box, self.build_devices())

    def fill(self, box, widget):
        """Put a freshly built section in its pinned box, or inline."""
        if box is None:
            self.columns.append(widget)
            return
        child = box.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            box.remove(child)
            child = nxt
        box.append(widget)

    # -- sections -----------------------------------------------------------
    def section_head(self, title, key, count):
        """A heading that folds its section away.

        Drives, printers and a scanner together are taller than the strip
        they live in, and most of the time you want one of them. Folding is
        per section and is remembered, so a dock set up for printing comes
        back set up for printing.
        """
        open_now = self.config[key]
        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        label = "%s  %s" % ("\u25be" if open_now else "\u25b8", title)
        if not open_now and count:
            label += "  %d" % count
        # The whole row folds, not just the six characters of the word. A
        # button sized to its label leaves most of a 300px heading dead to
        # the pointer, and a heading that ignores a click on itself reads
        # as broken - which is exactly how it read.
        text = Gtk.Label(label=label, xalign=0.0)
        text.set_hexpand(True)
        toggle = Gtk.Button()
        toggle.set_child(text)
        toggle.set_hexpand(True)
        toggle.set_halign(Gtk.Align.FILL)
        toggle.add_css_class("devices-title")
        toggle.add_css_class("section-head")
        toggle.set_tooltip_text("fold this section away" if open_now
                                else "show %s again" % title.lower())
        toggle.connect("clicked", self.on_section_toggle, key)
        head.append(toggle)
        return head

    # -- tray ---------------------------------------------------------------
    def build_tray(self):
        """The status icons from the right of the top bar, along the bottom.

        Same glyphs and the same actions the bar ran, so the bar itself has
        nothing left to do. A start button leads the row because a dock
        without one sends you back to a keybind you have to remember.
        """
        tray = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=2)
        tray.add_css_class("tray")
        icons = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=2)
        icons.set_homogeneous(True)
        icons.set_hexpand(True)
        tray.append(icons)

        def button(key, glyph, tooltip, command, right=None):
            item = Gtk.Button(label=glyph)
            item.add_css_class("tray-button")
            item.set_tooltip_text(tooltip)
            item.connect("clicked", lambda _b: self.launch(command))
            if right is not None:
                gesture = Gtk.GestureClick()
                gesture.set_button(3)
                gesture.connect("pressed", lambda *_: self.on_tray_right(key, right))
                item.add_controller(gesture)
            self.tray_buttons[key] = item
            icons.append(item)
            return item

        button("start", TRAY_GLYPHS["start"], "applications",
               ["rofi", "-show", "drun"])
        volume = button("volume", TRAY_GLYPHS["volume"][2], "sound",
                        ["pavucontrol"], right="mute")
        scroll = Gtk.EventControllerScroll(
            flags=Gtk.EventControllerScrollFlags.VERTICAL)
        scroll.connect("scroll", self.on_tray_scroll)
        volume.add_controller(scroll)
        button("net", TRAY_GLYPHS["net_on"], "network",
               [os.path.join(HOME_BIN, "wifi-menu")])
        button("bt", TRAY_GLYPHS["bt_off"], "bluetooth", ["overskride"])
        button("notify", TRAY_GLYPHS["bell"], "notifications",
               ["swaync-client", "-t", "-sw"],
               right=["swaync-client", "-d", "-sw"])
        button("lock", TRAY_GLYPHS["lock"], "lock the screen", ["hyprlock"])

        self.clock_label = Gtk.Label(label=time.strftime("%H:%M"), xalign=1.0)
        self.clock_label.add_css_class("tray-clock")
        tray.append(self.clock_label)
        return tray

    def launch(self, command):
        """Run a tray action detached, with the rice's click."""
        sound = os.path.join(HOME_BIN, "rice-sfx")
        if os.path.exists(sound):
            subprocess.Popen([sound, "play", "click"],
                             stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)
        try:
            subprocess.Popen(command, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
        except OSError as error:
            self.drive_note = "%s: %s" % (os.path.basename(command[0]), error)
            self.refresh_sections()

    def on_tray_right(self, key, action):
        if action == "mute":
            threading.Thread(target=self._mute, daemon=True).start()
        else:
            self.launch(action)

    def _mute(self):
        hypr_devices.toggle_mute()
        GLib.idle_add(self.refresh_tray)

    def on_tray_scroll(self, _controller, _dx, dy):
        """Scroll the volume the way the bar did: five points a notch."""
        step = -5 if dy > 0 else 5

        def work():
            hypr_devices.set_volume(step)
            GLib.idle_add(self.refresh_tray)
        threading.Thread(target=work, daemon=True).start()
        return True

    def refresh_tray(self):
        if not self.tray_buttons:
            return True

        def work():
            state = hypr_devices.tray_state()
            GLib.idle_add(self.apply_tray, state)
        threading.Thread(target=work, daemon=True).start()
        return True

    def apply_tray(self, state):
        if not self.tray_buttons:
            return False
        volume, muted = state["volume"], state["muted"]
        sound = self.tray_buttons["volume"]
        if muted or volume is None:
            sound.set_label(TRAY_GLYPHS["muted"])
            sound.set_tooltip_text("muted - right-click to unmute")
        else:
            steps = TRAY_GLYPHS["volume"]
            sound.set_label(steps[min(len(steps) - 1, volume // 34)])
            sound.set_tooltip_text(
                "volume %d%% - scroll to change, right-click to mute, click "
                "for pavucontrol" % volume)
        self._dim(sound, muted)

        net = self.tray_buttons["net"]
        net.set_label(TRAY_GLYPHS["net_on"] if state["net"]
                      else TRAY_GLYPHS["net_off"])
        net.set_tooltip_text("%s: %s" % (state["net"], state["net_name"])
                             if state["net"] else "disconnected")
        self._dim(net, not state["net"])

        bt = self.tray_buttons["bt"]
        bt.set_label(TRAY_GLYPHS["bt_connected"] if state["bt_connected"]
                     else TRAY_GLYPHS["bt_on"] if state["bt_on"]
                     else TRAY_GLYPHS["bt_off"])
        bt.set_tooltip_text("bluetooth: %s" % (
            "a device is connected" if state["bt_connected"]
            else "on, nothing connected" if state["bt_on"] else "off"))
        self._dim(bt, not state["bt_on"])

        bell = self.tray_buttons["notify"]
        count = state["notifications"]
        bell.set_label(TRAY_GLYPHS["bell_new"] if count
                       else TRAY_GLYPHS["bell"])
        bell.set_tooltip_text(
            ("do not disturb - " if state["dnd"] else "")
            + ("%d waiting" % count if count else "nothing waiting")
            + " - right-click for do not disturb")
        self._dim(bell, state["dnd"])

        self.clock_label.set_label(time.strftime("%H:%M"))
        self.clock_label.set_tooltip_text(time.strftime("%A %d %B %Y"))
        return False

    def _dim(self, widget, dim):
        if dim:
            widget.add_css_class("tray-dim")
        else:
            widget.remove_css_class("tray-dim")

    def on_section_toggle(self, _button, key):
        self.config[key] = not self.config[key]
        save_config(self.config)
        self.refresh_sections()

    # -- drives -------------------------------------------------------------
    def build_drives(self):
        """Mountable block devices, grouped by the thing you plug in.

        What the dock can actually do to a drive is not a matter of taste:
        polkit lets an active local session mount and unmount anything
        udisks does *not* flag as part of the system, and refuses the rest
        unless an authentication agent is running to ask for a password. So
        a fixed disk gets the facts and an Open button; a stick you plugged
        in gets the buttons that will work.
        """
        section = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
        section.add_css_class("ws")

        head = self.section_head("DRIVES", "drives_open", len(self.drives))
        section.append(head)
        if not self.config["drives_open"]:
            return section
        scope = Gtk.Button(label="all" if self.config["drives_fixed"]
                           else "plugged in")
        scope.add_css_class("device-button")
        scope.set_tooltip_text(
            "showing every disk in the machine - click for only what is "
            "removable or mounted under /mnt"
            if self.config["drives_fixed"] else
            "showing what is removable or mounted under /mnt - click for "
            "every disk in the machine")
        scope.connect("clicked", self.on_drives_scope)
        head.append(scope)

        for group in self.drives:
            section.append(self.drive_card(group))
        live = {g["path"] for g in self.drives}
        detached = [(path, record) for path, record in sorted(self.ejected.items())
                    if path not in live and record.get("backing_file")]
        for path, record in detached:
            section.append(self.detached_card(path, record))
        if not self.drives and not detached:
            empty = Gtk.Label(label="nothing plugged in", xalign=0.0)
            empty.add_css_class("empty")
            section.append(empty)
        if self.drive_note:
            note = Gtk.Label(label=self.drive_note, xalign=0.0)
            note.add_css_class("device-meta")
            note.set_wrap(True)
            note.set_max_width_chars(34)
            section.append(note)
        return section

    def drive_card(self, group):
        row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        row.add_css_class("chip")
        volumes = group["volumes"]
        single = len(volumes) == 1

        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        # One volume is the usual case - a stick, an external disk - and
        # then its label is the name worth showing. A partitioned disk is
        # named by the hardware, with the volumes listed under it.
        title = ((volumes[0]["label"] or group["model"] or group["name"])
                 if single else (group["model"] or group["name"]))
        name = Gtk.Label(label=title, xalign=0.0)
        name.add_css_class("device-name")
        name.set_ellipsize(3)
        name.set_max_width_chars(20)
        name.set_hexpand(True)
        top.append(name)
        bus = Gtk.Label(label=(group["bus"] or "disk"))
        bus.add_css_class("pill")
        bus.add_css_class("pill-ok" if group["removable"] else "pill-idle")
        bus.set_tooltip_text("%s, %s%s"
                             % (group["path"],
                                hypr_devices.human(group["size"]),
                                ", removable" if group["removable"] else ""))
        top.append(bus)
        row.append(top)

        gone = group["path"] in self.ejected
        if gone:
            # Powered off and still enumerated. Nothing here can be mounted
            # or ejected again; the only thing left to do is unplug it.
            told = Gtk.Label(label="ejected - safe to unplug", xalign=0.0)
            told.add_css_class("pill")
            told.add_css_class("pill-idle")
            told.set_tooltip_text(
                "the drive is powered down; unplug it and plug it back in to "
                "use it again")
            holder = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
            holder.append(told)
            row.append(holder)
            return row

        eject = None
        loop = group["kind"] == "loop"
        # udisks does not call a loop device removable - nothing was plugged
        # in - but detaching one is the same gesture, and without this the
        # loop branch below could never be reached.
        if loop or (group["removable"] and group["can_power_off"]):
            eject = Gtk.Button(label="detach" if loop else "eject")
            eject.add_css_class("device-button")
            mine = group.get("setup_uid") in (None, os.getuid())
            eject.set_tooltip_text(
                ("unmount this image and detach the loop device"
                 + ("" if mine else " - set up by another user, so this needs "
                                   "an admin")) if loop else
                "unmount everything on this drive and power it down, so it "
                "is safe to unplug")
            eject.set_sensitive(group["path"] not in self.drive_busy)
            eject.connect("clicked", self.on_drive_eject, group)

        for volume in volumes:
            # One volume, one button row: a drive you can eject is nearly
            # always a drive with a single filesystem on it, and giving the
            # eject a row of its own costs a line of a dock that has none
            # spare.
            row.append(self.volume_block(volume, single,
                                         eject if single else None))
        if eject is not None and not single:
            buttons = Gtk.FlowBox()
            buttons.set_selection_mode(Gtk.SelectionMode.NONE)
            buttons.set_max_children_per_line(8)
            buttons.set_column_spacing(4)
            buttons.insert(eject, -1)
            row.append(buttons)
        return row

    def detached_card(self, path, record):
        """A disk image with nothing attached: the one eject we can undo.

        A powered-off USB drive has to be pulled out and put back in - nothing
        in a user session can re-energise a port - but a loop device is only a
        file, so the detach has an obvious opposite and this offers it.
        """
        row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        row.add_css_class("chip")
        image = record.get("backing_file") or ""

        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        name = Gtk.Label(label=os.path.basename(image) or record.get("name", ""),
                         xalign=0.0)
        name.add_css_class("device-name")
        name.set_ellipsize(3)
        name.set_max_width_chars(20)
        name.set_hexpand(True)
        name.set_tooltip_text(image)
        top.append(name)
        pill = Gtk.Label(label="detached")
        pill.add_css_class("pill")
        pill.add_css_class("pill-idle")
        top.append(pill)
        row.append(top)

        buttons = Gtk.FlowBox()
        buttons.set_selection_mode(Gtk.SelectionMode.NONE)
        buttons.set_max_children_per_line(8)
        buttons.set_column_spacing(4)
        attach = Gtk.Button(label="re-attach")
        attach.add_css_class("device-button")
        attach.set_tooltip_text("map %s to a loop device again" % image)
        attach.set_sensitive(path not in self.drive_busy
                             and os.path.isfile(image))
        attach.connect("clicked", self.on_drive_reattach, path, record)
        buttons.insert(attach, -1)
        forget = Gtk.Button(label="forget")
        forget.add_css_class("device-button")
        forget.set_tooltip_text("stop listing this image")
        forget.connect("clicked", self.on_drive_forget, path)
        buttons.insert(forget, -1)
        row.append(buttons)
        return row

    def volume_block(self, volume, single, eject=None):
        block = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        mounted = bool(volume["mount"])
        busy = volume["path"] in self.drive_busy

        if not single:
            label = Gtk.Label(label=(volume["label"] or volume["name"]),
                              xalign=0.0)
            label.add_css_class("device-name")
            label.set_ellipsize(3)
            label.set_max_width_chars(24)
            block.append(label)

        facts = " · ".join(x for x in (
            volume["fstype"] or "no filesystem",
            hypr_devices.human(volume["size"]),
            "read-only" if volume["readonly"] else "") if x)
        meta = Gtk.Label(label=facts, xalign=0.0)
        meta.add_css_class("device-meta")
        block.append(meta)

        if mounted and volume["fssize"]:
            used = volume["used"] or 0
            share = max(0, min(100, round(100.0 * used / volume["fssize"])))
            line = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            text = Gtk.Label(label="%d%%  %s free"
                             % (share, hypr_devices.human(volume["avail"])),
                             xalign=0.0)
            text.add_css_class("device-meta")
            text.set_size_request(110, -1)
            line.append(text)
            bar = Gtk.LevelBar()
            bar.set_min_value(0)
            bar.set_max_value(100)
            bar.set_value(share)
            bar.set_hexpand(True)
            line.append(bar)
            block.append(line)

        where = Gtk.Label(
            label=(volume["mount"] + ("  +%d more" % volume["extra_mounts"]
                                      if volume["extra_mounts"] else ""))
            if mounted else "not mounted", xalign=0.0)
        where.add_css_class("device-meta" if mounted else "empty")
        where.set_ellipsize(2)  # PANGO_ELLIPSIZE_MIDDLE: keep both ends
        where.set_max_width_chars(30)
        block.append(where)

        buttons = Gtk.FlowBox()
        buttons.set_selection_mode(Gtk.SelectionMode.NONE)
        buttons.set_max_children_per_line(8)
        buttons.set_column_spacing(4)
        buttons.set_row_spacing(4)
        if mounted:
            open_it = Gtk.Button(label="open")
            open_it.add_css_class("device-button")
            open_it.set_tooltip_text("open %s in the file manager"
                                     % volume["mount"])
            open_it.connect("clicked", self.on_drive_open, volume["mount"])
            buttons.insert(open_it, -1)
        action = Gtk.Button(label="working..." if busy else
                            ("unmount" if mounted else "mount"))
        action.add_css_class("device-button")
        action.set_sensitive(not busy and not volume["protected"])
        if volume["protected"]:
            action.set_tooltip_text(
                "%s is part of the running system - the dock will not "
                "offer to pull it out from under you" % volume["mount"])
        elif volume["system"]:
            action.set_tooltip_text(
                "udisks counts this as a system disk, so this needs "
                "authorisation: it only works with a polkit agent running "
                "to ask for the password")
        else:
            action.set_tooltip_text(
                "unmount it, then it is safe to unplug" if mounted
                else "mount it under /run/media")
        action.connect("clicked", self.on_drive_action, volume, mounted)
        buttons.insert(action, -1)
        if eject is not None:
            buttons.insert(eject, -1)
        block.append(buttons)
        return block

    # -- drive actions ------------------------------------------------------
    def on_drives_scope(self, _button):
        self.config["drives_fixed"] = not self.config["drives_fixed"]
        save_config(self.config)
        self.refresh_drives()

    def on_drive_open(self, _button, mount):
        subprocess.Popen(["xdg-open", mount],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def on_drive_action(self, _button, volume, mounted):
        """Mount or unmount, on a thread: udisks can take a few seconds."""
        path = volume["path"]
        self.drive_busy.add(path)
        self.drive_note = "%s %s..." % ("unmounting" if mounted else "mounting",
                                        os.path.basename(path))
        self.refresh_sections()

        def work():
            done, message = ((hypr_devices.unmount(path)) if mounted
                             else hypr_devices.mount(path))
            GLib.idle_add(self.apply_drive_result, path, done, message)
        threading.Thread(target=work, daemon=True).start()

    def on_drive_eject(self, _button, group):
        """Unmount everything on the drive, then spin it down."""
        path = group["path"]
        self.drive_busy.add(path)
        self.drive_note = "ejecting %s..." % os.path.basename(path)
        self.refresh_sections()
        mounts = [v["path"] for v in group["volumes"] if v["mount"]]
        loop = group["kind"] == "loop"
        record = {
            "kind": group["kind"],
            "backing_file": group.get("backing_file", ""),
            "name": (group["model"] or group["name"]),
            "bus": group["bus"],
        }

        def work():
            for volume in mounts:
                done, message = hypr_devices.unmount(volume)
                if not done:
                    GLib.idle_add(self.apply_drive_result, path, False,
                                  message)
                    return
            done, message = (hypr_devices.loop_delete(path) if loop
                             else hypr_devices.power_off(path))
            if done:
                GLib.idle_add(self.remember_ejected, path, record)
            GLib.idle_add(self.apply_drive_result, path, done, message)
        threading.Thread(target=work, daemon=True).start()

    def remember_ejected(self, path, record):
        # Wall-clock, not the monotonic clock: this has to still mean
        # something after a restart, and a monotonic clock starts again
        # from zero every boot.
        record["at"] = time.time()
        self.ejected[path] = record
        self.save_ejected()
        return False

    def save_ejected(self):
        """Keep the ejected drives across a restart of the dock.

        The DRV and DEV buttons restart the dock to settle the layout, and a
        detached disk image that loses its re-attach button on the way is the
        one eject that can be undone.
        """
        self.config["ejected"] = dict(self.ejected)
        save_config(self.config)

    def on_drive_reattach(self, _button, path, record):
        """Put a detached image back - the re-insert of a disk image."""
        image = record.get("backing_file") or ""
        self.drive_busy.add(path)
        self.drive_note = "attaching %s..." % os.path.basename(image)
        self.refresh_sections()

        def work():
            done, message = hypr_devices.loop_setup(image)
            GLib.idle_add(self.apply_reattach, path, done, message)
        threading.Thread(target=work, daemon=True).start()

    def apply_reattach(self, path, done, message):
        self.drive_busy.discard(path)
        if done:
            self.ejected.pop(path, None)
            self.save_ejected()
        self.drive_note = message if done else "could not: %s" % message
        self.refresh_drives()
        return False

    def on_drive_forget(self, _button, path):
        self.ejected.pop(path, None)
        self.save_ejected()
        self.refresh_sections()

    def apply_drive_result(self, path, done, message):
        self.drive_busy.discard(path)
        self.drive_note = message if done else "could not: %s" % message
        self.refresh_drives()
        return False

    # -- drive state --------------------------------------------------------
    def refresh_drives(self):
        def work():
            found = hypr_devices.list_drives(self.config["drives_fixed"],
                                             keep=tuple(self.ejected))
            GLib.idle_add(self.apply_drives, found)
        threading.Thread(target=work, daemon=True).start()
        return True

    def apply_drives(self, found):
        self.drives = found
        before = dict(self.ejected)
        self.ejected = hypr_devices.prune_ejected(
            self.ejected, found, time.time(), EJECT_GRACE)
        if self.ejected != before:
            self.save_ejected()
        self.refresh_sections()
        return False

    def schedule_drives(self):
        """One redraw for the burst of udev events a plug-in produces."""
        if self.drive_pending:
            GLib.source_remove(self.drive_pending)
        self.drive_pending = GLib.timeout_add(900, self.drives_settled)
        return False

    def drives_settled(self):
        self.drive_pending = 0
        self.refresh_drives()
        return False

    def watch_block_events(self):
        """Hotplug, live: a stick appears the moment udev has settled.

        The udev stream, not the kernel one - kernel uevents need root,
        and the udev events are the ones that arrive after the device has
        been set up, which is when there is anything worth drawing.
        """
        def reader():
            try:
                stream = subprocess.Popen(
                    ["udevadm", "monitor", "--udev",
                     "--subsystem-match=block"],
                    stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                    text=True)
            except OSError:
                return
            for line in stream.stdout:
                if "UDEV" in line and any(
                        word in line for word in (" add ", " remove ",
                                                  " change ", " bind ")):
                    GLib.idle_add(self.schedule_drives)
        threading.Thread(target=reader, daemon=True).start()

    # -- printers and scanners ----------------------------------------------
    def profile(self):
        """The scan profile in use, falling back to the first one defined."""
        wanted = self.config.get("scan_profile")
        for entry in self.config["scan_profiles"]:
            if entry.get("name") == wanted:
                return entry
        return self.config["scan_profiles"][0]

    def profile_folder(self, entry=None):
        entry = entry or self.profile()
        return os.path.expanduser(entry.get("folder") or hypr_devices.SCAN_DIR)

    def build_devices(self):
        """CUPS destinations and SANE scanners, in the dock's own idiom.

        The state CUPS reports and whether the device actually answers are
        two different things: a queue says `idle` for a printer that is
        asleep, off, or on a network you have left.
        """
        section = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
        section.add_css_class("ws")

        head = self.section_head("DEVICES", "devices_open",
                                 len(self.printers) + len(self.scanners))
        section.append(head)
        if not self.config["devices_open"]:
            return section
        again = Gtk.Button(label="looking..." if self.looking else "refresh")
        again.add_css_class("device-button")
        again.set_tooltip_text("look for printers and scanners again")
        again.set_sensitive(not self.looking)
        again.connect("clicked", lambda *_: self.refresh_devices(force=True))
        head.append(again)

        for printer in self.printers:
            section.append(self.device_row(printer))
        for scanner in self.scanners:
            row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
            row.add_css_class("chip")
            title = Gtk.Label(
                label="%s %s" % (scanner["vendor"], scanner["model"]),
                xalign=0.0)
            title.add_css_class("device-name")
            title.set_ellipsize(3)
            title.set_max_width_chars(26)
            row.append(title)
            status = self.scan_status.get(scanner["device"], {})
            if status.get("text"):
                line = Gtk.Label(label=status["text"], xalign=0.0)
                line.add_css_class("pill")
                line.add_css_class("pill-ok" if status.get("ready")
                                   else "pill-bad")
                holder = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
                holder.append(line)
                row.append(holder)
            entry = self.profile()
            meta = Gtk.Label(
                label="%s %s, %d dpi" % (entry["source"].lower(),
                                         entry["mode"].lower(), entry["dpi"]),
                xalign=0.0)
            meta.add_css_class("device-meta")
            row.append(meta)
            where = Gtk.Label(label="to %s" % entry.get("folder", "~/Scans"),
                              xalign=0.0)
            where.add_css_class("device-meta")
            where.set_ellipsize(3)
            where.set_max_width_chars(30)
            row.append(where)
            buttons = Gtk.FlowBox()
            buttons.set_selection_mode(Gtk.SelectionMode.NONE)
            buttons.set_max_children_per_line(8)
            buttons.set_column_spacing(4)
            buttons.set_row_spacing(4)
            scan = Gtk.Button(label="scanning..." if self.scanning else "scan")
            scan.add_css_class("device-button")
            # Live off the paper sensor: the button comes up the moment a
            # sheet is in the feeder and greys out when it is taken away.
            # `ready` is None when the backend exposes no sensors at all, and
            # then the button stays available rather than being unusable.
            ready = status.get("ready")
            # Never blocked by the sensor: a sheet the scanner has not gripped
            # yet reads as "no paper", and a dead button would leave you
            # unable to scan the thing you are holding. The state is shown
            # above; pressing it when the feeder is empty just reports that.
            scan.set_sensitive(not self.scanning)
            scan.set_tooltip_text(
                "scan every sheet in the feeder to ~/Scans"
                if ready is not False else
                "the feeder reads as empty (%s) - press anyway if a sheet is in"
                % (status.get("text") or "no paper"))
            scan.connect("clicked", self.on_scan, scanner["device"])
            buttons.insert(scan, -1)
            kind = Gtk.Button(label=entry["name"])
            kind.add_css_class("device-button")
            kind.set_tooltip_text(
                "what you are scanning: documents, receipts, cards, photos.\n"
                "Each keeps its own folder and settings - click to change.")
            kind.connect("clicked", self.on_cycle_profile)
            buttons.insert(kind, -1)

            folder = Gtk.Button(label="folder")
            folder.add_css_class("device-button")
            folder.set_tooltip_text("open %s" % entry.get("folder"))
            folder.connect("clicked", self.on_open_folder)
            buttons.insert(folder, -1)

            # Click a setting to step to the next value the backend offers.
            for key, label in (("source", "side"), ("mode", "tone"),
                               ("resolution", "dpi")):
                button = Gtk.Button(label=label)
                button.add_css_class("device-button")
                button.set_tooltip_text(
                    "%s for %s: %s - click for the next value"
                    % (label, entry["name"],
                       entry[{"source": "source", "mode": "mode",
                              "resolution": "dpi"}[key]]))
                button.connect("clicked", self.on_cycle_setting,
                               scanner["device"], key, label)
                buttons.insert(button, -1)
            row.append(buttons)
            section.append(row)

        if not self.printers and not self.scanners:
            empty = Gtk.Label(
                label="nothing found yet" if not self.scanned_at
                else "no printers or scanners", xalign=0.0)
            empty.add_css_class("empty")
            section.append(empty)
        if self.device_note:
            note = Gtk.Label(label=self.device_note, xalign=0.0)
            note.add_css_class("device-meta")
            note.set_wrap(True)
            note.set_max_width_chars(34)
            section.append(note)
        return section

    def device_row(self, printer):
        row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        row.add_css_class("chip")

        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        name = Gtk.Label(label=printer["name"].replace("-", " "), xalign=0.0)
        name.add_css_class("device-name")
        name.set_ellipsize(3)
        name.set_max_width_chars(22)
        name.set_hexpand(True)
        top.append(name)
        link = self.links.get(printer["name"])
        # Kept short: the dock is 300px and the explanation is in the tooltip.
        mark = {"online": "on", "absent": "off", "refused": "no answer",
                "local": "usb"}.get(link, "checking")
        good = link in ("online", "local")
        # A printer that is not answering is the only time there is anything
        # to do about it, and the thing to do is wake it. That is the badge
        # itself: a fifth button does not fit on one row at this width, and
        # a row of its own for a button you see once a week is a row this
        # dock cannot spare.
        asleep = link in ("absent", "refused")
        badge = Gtk.Button(label=mark + " \u23fb") if asleep \
            else Gtk.Label(label=mark)
        badge.add_css_class("pill")
        badge.add_css_class("pill-ok" if good else
                            ("pill-bad" if link else "pill-idle"))
        badge.set_tooltip_text(
            {"absent": "its name does not resolve: the device is not on the "
                       "network.\n\nClick to send a wake-on-LAN packet. That "
                       "only reaches a printer that is asleep with its "
                       "network interface still powered - one that is "
                       "properly off, any battery printer that has shut "
                       "down, needs its own power button.",
             "refused": "the host answers but the print port is closed.\n\n"
                        "Click to send a wake-on-LAN packet.",
             "online": "answering on its print port",
             "local": "connected directly, not over the network"}.get(link, ""))
        if asleep:
            badge.connect("clicked", self.on_wake, printer["uri"])
        top.append(badge)
        row.append(top)

        status = self.printer_status.get(printer["name"], {})
        jobs = status.get("queued", len(printer["jobs"]))
        words = status.get("text") or printer["state"]
        # Two different facts live on this card: what the queue says and
        # whether the device answers. A queue that is ready for a printer
        # that is not there is not "ready" in any sense worth painting green.
        reachable = link in ("online", "local")
        good = bool(status.get("ready")) and reachable
        line = Gtk.Label(label="queue %s" % words, xalign=0.0)
        line.add_css_class("pill")
        line.add_css_class("pill-ok" if good else
                           ("pill-bad" if not status.get("ready")
                            else "pill-idle"))
        line.set_wrap(True)
        line.set_max_width_chars(28)
        holder = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        holder.append(line)       # so the pill hugs its text
        row.append(holder)

        for marker, level in status.get("inks", []):
            ink = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            label = Gtk.Label(label="%s %d%%" % (marker, level), xalign=0.0)
            label.add_css_class("device-meta")
            label.set_size_request(110, -1)
            ink.append(label)
            bar = Gtk.LevelBar()
            bar.set_min_value(0)
            bar.set_max_value(100)
            bar.set_value(max(0, min(100, level)))
            bar.set_hexpand(True)
            ink.append(bar)
            row.append(ink)

        buttons = Gtk.FlowBox()
        buttons.set_selection_mode(Gtk.SelectionMode.NONE)
        buttons.set_max_children_per_line(8)
        buttons.set_column_spacing(4)
        buttons.set_row_spacing(4)
        enabled = printer["state"] != "disabled"
        for label, args, note in (
            ("test", ["lp", "-d", printer["name"],
                      "/usr/share/cups/data/testprint"], "test page sent"),
            ("pause" if enabled else "resume",
             [("cupsdisable" if enabled else "cupsenable"), printer["name"]],
             "queue paused" if enabled else "queue resumed"),
            ("cancel", ["cancel", "-a", printer["name"]], "queue cleared"),
            ("web", ["xdg-open", "http://localhost:631/printers/%s"
                     % printer["name"]], "opened CUPS"),
        ) + ((), (("default", ["lpoptions", "-d", printer["name"]],
                   "default printer set"),))[not printer["default"]]:
            button = Gtk.Button(label=label)
            button.add_css_class("device-button")
            if label in ("pause", "resume"):
                button.set_tooltip_text(
                    "hold jobs in the queue instead of sending them. This is "
                    "the queue, not the hardware: a printer's power button is "
                    "not something a host can reach." if label == "pause"
                    else "send held jobs to the printer again")
            button.connect("clicked", self.on_device_action, args, note)
            if label == "cancel" and not jobs:
                button.set_sensitive(False)
            buttons.insert(button, -1)
        row.append(buttons)
        return row

    def on_wake(self, _button, uri):
        self.device_note = "waking..."
        self.refresh_sections()

        def work():
            mac = hypr_devices.device_mac(uri)
            sent, message = hypr_devices.wake(mac)
            GLib.idle_add(self.apply_scan_result,
                          message if sent else "could not wake: %s" % message)
        threading.Thread(target=work, daemon=True).start()

    def on_device_action(self, _button, args, _note):
        threading.Thread(
            target=lambda: (hypr_devices.run(args, timeout=15),
                            GLib.idle_add(self.refresh_devices)),
            daemon=True).start()

    def on_scan(self, _button, device):
        """Scan everything in the feeder, in colour at a sane resolution."""
        self.scanning = True
        self.device_note = "scanning - feed the sheets now"
        self.refresh_sections()

        entry = self.profile()
        folder = self.profile_folder(entry)

        def work():
            # Whatever happens in here, the UI has to be told: a thread that
            # dies quietly leaves the panel saying "scanning..." for ever.
            try:
                files, message = hypr_devices.scan(
                    device, source=entry["source"], mode=entry["mode"],
                    dpi=entry["dpi"], out_dir=folder,
                    options=entry.get("options"))
                note = ("%s saved to %s" % (message, entry.get("folder"))
                        if files else message)
            except Exception as error:               # noqa: BLE001
                note = "scan failed: %s" % error
            GLib.idle_add(self.apply_scan_result, note)
        self.scan_started = time.monotonic()
        threading.Thread(target=work, daemon=True).start()

    def on_cycle_setting(self, _button, device, key, setting):
        """Step a scan setting to the next value this scanner supports."""
        options = self.scan_options.get(device)
        if not options:
            self.device_note = "asking the scanner what it supports..."
            self.refresh_sections()

            def work():
                found = hypr_devices.scanner_options(device)
                GLib.idle_add(self.apply_options, device, found, key, setting)
            threading.Thread(target=work, daemon=True).start()
            return
        self.step_setting(options, key, setting)

    def apply_options(self, device, options, key, setting):
        self.scan_options[device] = options
        self.device_note = ""
        self.step_setting(options, key, setting)
        return False

    def step_setting(self, options, key, setting):
        """Settings belong to the profile, so receipts can differ from photos."""
        entry = self.profile()
        field = {"source": "source", "mode": "mode", "resolution": "dpi"}[key]
        values = options.get(key) or []
        current = str(entry[field])
        nxt = values[(values.index(current) + 1) % len(values)] \
            if current in values else (values[0] if values else current)
        entry[field] = int(nxt) if key == "resolution" else nxt
        save_config(self.config)
        self.refresh_sections()

    def on_cycle_profile(self, _button):
        names = [e.get("name") for e in self.config["scan_profiles"]]
        current = self.profile().get("name")
        self.config["scan_profile"] = names[
            (names.index(current) + 1) % len(names)] if current in names \
            else names[0]
        save_config(self.config)
        self.refresh_sections()

    def on_open_folder(self, _button):
        folder = self.profile_folder()
        os.makedirs(folder, exist_ok=True)
        threading.Thread(
            target=lambda: hypr_devices.run(["xdg-open", folder], timeout=10),
            daemon=True).start()

    def apply_scan_result(self, note):
        self.scanning = False
        self.device_note = note
        self.refresh_sections()
        # The feeder is emptier than it was: re-read the sensors.
        self.find_scanners()
        return False

    def refresh_devices(self, force=False):
        """Local CUPS state now; the slow probes on their own schedules."""
        def work():
            printers = hypr_devices.read_queue()
            status = {p["name"]: hypr_devices.printer_status(p["name"])
                      for p in printers}
            GLib.idle_add(self.apply_devices, printers, status)
        threading.Thread(target=work, daemon=True).start()
        if force:
            self.probe_devices()
            self.find_scanners()
        return True

    def apply_devices(self, printers, status=None):
        fresh = {p["name"] for p in printers} - set(self.links)
        self.printers = printers
        self.printer_status = status or {}
        self.refresh_sections()
        if fresh:
            # Chain the first probe to the queue landing: fired alongside it,
            # it would run against an empty list and leave every printer
            # showing "..." until the next sweep.
            self.probe_devices()
        return False

    def probe_devices(self):
        def work():
            links = {p["name"]: hypr_devices.probe(p["uri"])
                     for p in list(self.printers)}
            GLib.idle_add(self.apply_links, links)
        threading.Thread(target=work, daemon=True).start()
        return True

    def apply_links(self, links):
        self.links = links
        self.refresh_sections()
        return False

    def refresh_scan_status(self):
        """Re-read sensors only - no enumeration, so this is nearly free."""
        if self.scanning and time.monotonic() - self.scan_started > 960:
            # Longer than the backend's own timeout: nothing is coming back.
            self.scanning = False
            self.device_note = "scan timed out"
            self.refresh_sections()
        if not self.scanners or self.scanning:
            return True

        def work():
            status = {s["device"]: hypr_devices.scanner_status(s["device"])
                      for s in list(self.scanners)}
            GLib.idle_add(self.apply_scan_status, status)
        threading.Thread(target=work, daemon=True).start()
        return True

    def apply_scan_status(self, status):
        if status != self.scan_status:
            self.scan_status = status
            self.refresh_sections()
        if self.config["scan_button"] and not self.scanning:
            # The Scan button on the machine: the backend cannot light it,
            # but it can tell us it was pressed, so pressing it does the
            # obvious thing. Only on the press itself - a sensor that reads
            # pressed on two polls running must not start two scans.
            for device, state in status.items():
                pressed = bool(state.get("sensors", {}).get("scan"))
                if pressed and not self.button_was_down.get(device):
                    self.button_was_down[device] = True
                    self.on_scan(None, device)
                    break
                self.button_was_down[device] = pressed
        return False

    def find_scanners(self):
        if self.looking:
            return True
        self.looking = True
        self.refresh_sections()

        def work():
            found = hypr_devices.list_scanners()
            status = {s["device"]: hypr_devices.scanner_status(s["device"])
                      for s in found}
            GLib.idle_add(self.apply_scanners, found, status)
        threading.Thread(target=work, daemon=True).start()
        return True

    def apply_scanners(self, found, status=None):
        self.looking = False
        self.scanners = found
        self.scan_status = status or {}
        self.scanned_at = time.time()
        self.refresh_sections()
        return False

    def build_section(self, key, windows, active_ids, active_special, focused):
        is_active = (key in active_ids if isinstance(key, int)
                     else key in active_special)
        section = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
        section.add_css_class("ws")
        if is_active:
            section.add_css_class("ws-active")

        if self.config["ws_colors"]:
            section.add_css_class("ws-c%d" % self.ws_tone(key))

        label = str(key) if isinstance(key, int) else key.upper()
        name = Gtk.Label(label=label, xalign=0.0 if self.vertical else 0.5)
        name.add_css_class("ws-name")
        # Shrink-to-fit, or the colour would paint the whole header width
        # instead of sitting behind the number as a badge.
        name.set_halign(Gtk.Align.START if self.vertical else Gtk.Align.CENTER)
        if is_active:
            name.add_css_class("ws-name-active")
        section.append(name)

        if windows:
            for client in windows:
                section.append(self.build_chip(client, focused))
        else:
            placeholder = Gtk.Label(label="drop here",
                                    xalign=0.0 if self.vertical else 0.5)
            placeholder.add_css_class("empty")
            section.append(placeholder)

        target = Gtk.DropTarget.new(GObject.TYPE_STRING, Gdk.DragAction.MOVE)
        target.connect("drop", self.on_drop, key)
        target.connect("enter", self.on_drop_enter, section)
        target.connect("leave", self.on_drop_leave, section)
        section.add_controller(target)
        return section

    def ws_tone(self, key):
        """Which colour in the ring this workspace gets.

        Numbered workspaces take their own slot, so a desktop keeps its
        colour for as long as it keeps its number. Named (special)
        workspaces have no number to key off, so they hash into the same
        ring - stable across restarts, which a counter would not be.
        """
        count = len(ws_colors(palette()))
        if isinstance(key, int):
            return (key - 1) % count
        return sum(ord(c) for c in str(key)) % count

    def build_chip(self, client, focused):
        address = client.get("address", "")
        title = str(client.get("title") or "")
        chip = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        chip.add_css_class("chip")
        if address and address == focused:
            chip.add_css_class("chip-focused")

        klass = Gtk.Label(label=(client.get("class") or "?")[:14], xalign=0.0)
        klass.add_css_class("chip-class")
        chip.append(klass)
        name = Gtk.Label(label=title, xalign=0.0)
        name.add_css_class("chip-title")
        name.set_ellipsize(3)
        name.set_max_width_chars(26)
        name.set_hexpand(True)
        chip.append(name)
        chip.set_tooltip_text("%s\n%s\n\nclick to go to it, drag to a "
                              "workspace, X to close"
                              % (client.get("class") or "?", title))

        close = Gtk.Button(label="✕")
        close.add_css_class("chip-close")
        close.set_tooltip_text("close this window")
        close.connect("clicked", self.on_close_clicked, address)
        chip.append(close)

        self.chips[address] = (name, chip)

        source = Gtk.DragSource()
        source.set_actions(Gdk.DragAction.MOVE)
        source.connect("prepare", self.on_drag_prepare, address)
        chip.add_controller(source)

        click = Gtk.GestureClick()
        click.connect("released", self.on_chip_clicked, address)
        chip.add_controller(click)
        return chip

    # -- interaction --------------------------------------------------------
    def on_drag_prepare(self, _source, _x, _y, address):
        return Gdk.ContentProvider.new_for_value(address)

    def on_drop(self, _target, value, _x, _y, key):
        if value:
            move_window(value, lua_workspace(key))
            self.schedule_refresh(120)
        return True

    def on_drop_enter(self, _target, _x, _y, section):
        section.add_css_class("ws-drop")
        return Gdk.DragAction.MOVE

    def on_drop_leave(self, _target, section):
        section.remove_css_class("ws-drop")

    def on_chip_clicked(self, _gesture, _n, _x, _y, address):
        focus_window(address)
        self.schedule_refresh(120)

    def on_close_clicked(self, _button, address):
        close_window(address)
        self.schedule_refresh(200)

    # -- live updates -------------------------------------------------------
    def schedule_refresh(self, delay=60):
        """Collapse the burst of events one action produces into one redraw."""
        if self.pending:
            GLib.source_remove(self.pending)
        self.pending = GLib.timeout_add(delay, self.refresh_windows)

    def watch_events(self):
        signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
        path = os.path.join(RUNTIME, "hypr", signature, ".socket2.sock")

        def reader():
            try:
                sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                sock.connect(path)
            except OSError:
                return
            buffer = b""
            while True:
                chunk = sock.recv(4096)
                if not chunk:
                    return
                buffer += chunk
                while b"\n" in buffer:
                    line, buffer = buffer.split(b"\n", 1)
                    event = line.decode("utf-8", "replace").split(">>")[0]
                    if event in ("activewindow", "activewindowv2", "openwindow",
                                 "closewindow", "movewindow", "movewindowv2",
                                 "workspace", "workspacev2", "focusedmon",
                                 "windowtitle", "windowtitlev2", "fullscreen",
                                 "activespecial", "monitoradded"):
                        GLib.idle_add(self.schedule_refresh)

        threading.Thread(target=reader, daemon=True).start()


# -------------------------------------------------------------------- main --
def parse_args(config):
    """Flags override the stored settings; --save makes them the settings."""
    args = sys.argv[1:]
    for position in ("left", "right", "top", "bottom"):
        if "--" + position in args:
            config["position"] = position
    if "--lock" in args:
        config["locked"] = True
    if "--pop-in" in args or "--no-lock" in args:
        config["locked"] = False
    if "--width" in args:
        try:
            config["width"] = int(args[args.index("--width") + 1])
        except (IndexError, ValueError):
            pass
    if "--save" in args:
        save_config(config)
    return config


def main():
    if "--help" in sys.argv or "-h" in sys.argv:
        print(__doc__)
        print("usage: hypr-windows [--left|--right|--top|--bottom] "
              "[--lock|--pop-in] [--width N] [--save] [--no-toggle]")
        print("settings file: %s" % CONFIG_FILE)
        return 0

    config = parse_args(load_config())
    with open(PID_FILE, "w") as handle:
        handle.write("%d %s\n" % (os.getpid(),
                                   "locked" if config["locked"] else "pop-in"))

    ensure_instance()
    loop = GLib.MainLoop()
    for sig in (signal.SIGTERM, signal.SIGINT):
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, sig,
                             lambda: (loop.quit(), True)[1])
    widget = WindowMap(config)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1,
                         lambda: (widget.toggle_visible(), True)[1])
    widget.watch_events()
    # The tray is cheap to read - about a tenth of a second, most of it
    # bluetoothctl - so a five-second beat keeps the clock honest to the
    # minute without being worth a smarter schedule.
    widget.refresh_tray()
    GLib.timeout_add_seconds(5, widget.refresh_tray)
    if config["drives"]:
        widget.refresh_drives()
        widget.watch_block_events()
        GLib.timeout_add_seconds(config["drives_seconds"],
                                 widget.refresh_drives)
    if config["devices"]:
        widget.refresh_devices()
        widget.find_scanners()
        GLib.timeout_add_seconds(config["device_seconds"],
                                 widget.refresh_devices)
        GLib.timeout_add_seconds(config["probe_seconds"], widget.probe_devices)
        GLib.timeout_add_seconds(config["scanner_seconds"],
                                 widget.find_scanners)
        GLib.timeout_add_seconds(config["sensor_seconds"],
                                 widget.refresh_scan_status)
    try:
        loop.run()
    finally:
        try:
            if int(open(PID_FILE).read().split()[0]) == os.getpid():
                os.unlink(PID_FILE)
        except (OSError, ValueError):
            pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
