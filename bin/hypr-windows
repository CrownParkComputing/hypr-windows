    "drives_seconds": 30,   # a safety net re-read; hotplug arrives by udev
    "drives_open": True,    # False folds the section to its heading
    "devices_open": True,   # the same for the printers and scanners
    "devices": True,        # printers and scanners at the end of the list
    # Drives that have been ejected, and when. Kept because the DRV toggle
    # restarts the dock, and a detached disk image that loses its re-attach
    # button on the way is the one eject that can be undone.
    "ejected": {},
    # What you are scanning decides where it goes and how it is read. Each
    # profile is a folder plus the settings that suit that kind of paper:
    # duplex everywhere because a sheet fed face-down should still come back
    # readable, auto-crop for anything smaller than a page, and blank-page
    # skipping so the backs of one-sided documents are not kept.
    "scan_profile": "documents",
    "scan_profiles": [
        {"name": "documents", "folder": "~/Scans/Documents",
         "source": "ADF Duplex", "mode": "Color", "dpi": 300,
         "options": ["--swdeskew=yes", "--swskip=5"]},
        {"name": "receipts", "folder": "~/Scans/Receipts",
         "source": "ADF Duplex", "mode": "Color", "dpi": 300,
         "options": ["--swcrop=yes", "--swdeskew=yes", "--swskip=5",
