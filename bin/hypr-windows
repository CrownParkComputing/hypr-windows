#!/usr/bin/env python3
"""hypr-windows - an on-screen window map and dock for Hyprland 0.57.

Every open window, grouped by the workspace it sits on. Click a window to go
to it, drag it onto another workspace to move it, press its X to close it,
and the top line always names the window that currently has focus.

It can live on any edge, either locked open as a dock that reserves its strip
or popping in from the edge when the pointer touches it.

Hyprland 0.57's dispatchers are Lua and only honour a window *object*:
"address:0x..." as a string either fails to parse or - for close - is accepted
and acted on whatever window has focus, which is how an unrelated browser
window once died here. So every action goes through `hyprctl eval` with a loop
over hl.get_windows() matched on w.address, the one form that reliably targets
the window you meant.
"""

import os
import sys

# gtk4-layer-shell has to be loaded before libwayland-client, which a script
# cannot arrange at link time. Re-exec once with it preloaded, or the window
# comes up as an ordinary toplevel instead of a dock.
_PRELOAD = "/usr/lib/libgtk4-layer-shell.so"
if not os.environ.get("HYPR_WINDOWS_PRELOAD") and os.path.exists(_PRELOAD):
    os.environ["HYPR_WINDOWS_PRELOAD"] = "1"
    _existing = os.environ.get("LD_PRELOAD", "")
    os.environ["LD_PRELOAD"] = _PRELOAD + (":" + _existing if _existing else "")
    os.environ.setdefault("GTK_A11Y", "none")
    os.execv(sys.executable,
             [sys.executable, os.path.abspath(__file__), *sys.argv[1:]])

import fcntl  # noqa: E402
import json  # noqa: E402
import signal  # noqa: E402
import socket  # noqa: E402
import subprocess  # noqa: E402
import threading  # noqa: E402
import time  # noqa: E402

RUNTIME = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
PID_FILE = os.path.join(RUNTIME, "hypr-windows.pid")
LOCK_FILE = os.path.join(RUNTIME, "hypr-windows.lock")
CONFIG_DIR = os.path.expanduser("~/.config/hypr-windows")
CONFIG_FILE = os.path.join(CONFIG_DIR, "config.json")


def claim_singleton():
    """Hold an exclusive lock for as long as this instance lives.

    A PID file alone loses a race: GTK takes about a second to come up, so
    two clicks inside that window both find no PID file and both start. The
    lock is taken here, before the GTK import, so the second one always
    loses. It is dropped automatically when the process exits, and released
    across the re-exec a settings change does (the fd is close-on-exec),
    which is why the new image can take it straight back.
    """
    handle = open(LOCK_FILE, "a+")
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return handle
    except OSError:
        handle.close()
        return None


def signal_running(sig):
    try:
        with open(PID_FILE) as handle:
            pid = int(handle.read().split()[0])
        if pid != os.getpid():
            os.kill(pid, sig)
    except (OSError, ValueError):
        pass


if "--help" not in sys.argv and "-h" not in sys.argv:
    _LOCK = claim_singleton()
    if _LOCK is None:
        # Somebody is already up. A plain launch toggles them - quitting a
        # locked dock, sliding a pop-in one - and --no-toggle just leaves.
        if "--no-toggle" not in sys.argv:
            # The running instance records the mode it is actually in on the
            # second line of its PID file, which is what matters here: a flag
            # override means the stored config can say something else.
            locked = True
            try:
                with open(PID_FILE) as handle:
                    lines = handle.read().split()
                locked = lines[1] != "pop-in"
            except (OSError, IndexError):
                try:
                    with open(CONFIG_FILE) as handle:
                        locked = bool(json.load(handle).get("locked", True))
                except (OSError, ValueError):
                    pass
            signal_running(signal.SIGTERM if locked else signal.SIGUSR1)
        sys.exit(0)

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import hypr_devices  # noqa: E402

import gi  # noqa: E402

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
from gi.repository import Gdk, GLib, GObject, Gtk, Gtk4LayerShell  # noqa: E402

COLORS_CONF = os.path.expanduser("~/.config/hypr/colors.conf")

DEFAULTS = {
    "position": "left",     # left | right | top | bottom
    "locked": True,         # True: a dock that reserves its strip
                            # False: pops in when the pointer touches the edge
    "width": 300,           # thickness of a left/right dock, in pixels
    "hide_delay_ms": 600,   # grace period before a popped-in dock withdraws
    "trigger_px": 4,        # thickness of the edge strip that pops it in
    "all_workspaces": False,  # False: only workspaces holding windows (plus
                              # the active one and one spare to drag into)
    "devices": True,        # printers and scanners at the end of the list
    # What you are scanning decides where it goes and how it is read. Each
    # profile is a folder plus the settings that suit that kind of paper:
    # duplex everywhere because a sheet fed face-down should still come back
    # readable, auto-crop for anything smaller than a page, and blank-page
    # skipping so the backs of one-sided documents are not kept.
    "scan_profile": "documents",
    "scan_profiles": [
        {"name": "documents", "folder": "~/Scans/Documents",
         "source": "ADF Duplex", "mode": "Color", "dpi": 300,
         "options": ["--swdeskew=yes", "--swskip=5"]},
        {"name": "receipts", "folder": "~/Scans/Receipts",
         "source": "ADF Duplex", "mode": "Color", "dpi": 300,
         "options": ["--swcrop=yes", "--swdeskew=yes", "--swskip=5",
                     "--ald=yes"]},
        {"name": "cards", "folder": "~/Scans/Business Cards",
         "source": "ADF Duplex", "mode": "Color", "dpi": 600,
         "options": ["--swcrop=yes", "--swdeskew=yes"]},
        {"name": "photos", "folder": "~/Scans/Photos",
         "source": "ADF Front", "mode": "Color", "dpi": 600,
         "options": ["--swcrop=yes"]},
    ],
    "scan_button": True,          # the scanner's own Scan button starts a
                                  # scan. Its LED cannot be driven from a
                                  # host - every sensor the backend exposes
                                  # is read-only - but the press is readable
    "sensor_seconds": 2,          # how often to re-read scanner sensors.
                                  # Naming the device makes this ~13ms; it is
                                  # `scanimage -L` enumeration that costs 8s
    "device_seconds": 15,   # how often to re-read the local CUPS queue
    "probe_seconds": 90,    # how often to ask the network if a printer is there
    "scanner_seconds": 600, # how often to re-enumerate SANE scanners
}

# The workspaces a full listing shows (config: all_workspaces). The default
# listing is built from what is actually in use instead.
BASE_WORKSPACES = list(range(1, 10))


# ------------------------------------------------------------------ config --
def load_config():
    config = dict(DEFAULTS)
    try:
        with open(CONFIG_FILE) as handle:
            stored = json.load(handle)
        if isinstance(stored, dict):
            config.update({k: v for k, v in stored.items() if k in DEFAULTS})
    except (OSError, json.JSONDecodeError):
        pass
    return config


def save_config(config):
    try:
        os.makedirs(CONFIG_DIR, exist_ok=True)
        with open(CONFIG_FILE, "w") as handle:
            json.dump(config, handle, indent=2)
            handle.write("\n")
    except OSError:
        pass


# ---------------------------------------------------------------- hyprland --
def hypr_json(command):
    """Run `hyprctl -j <command>` and return the parsed reply."""
    try:
        out = subprocess.run(
            ["hyprctl", "-j", *command.split()],
            capture_output=True, text=True, timeout=2, check=True,
        ).stdout
        return json.loads(out)
    except (subprocess.SubprocessError, json.JSONDecodeError):
        return None


def hypr_lua(code):
    """Evaluate Lua in the compositor. It answers 'ok' and returns nothing."""
    try:
        subprocess.run(["hyprctl", "eval", code],
                       capture_output=True, text=True, timeout=2)
    except subprocess.SubprocessError:
        pass


def ensure_instance():
    """Recover from a stale HYPRLAND_INSTANCE_SIGNATURE.

    A bar launches this, and a bar can outlive a compositor restart, so the
    signature we inherit may name a dead instance. Fix it before anything
    reads the event socket, whose path is keyed by the signature.
    """
    if hypr_json("activeworkspace"):
        return
    base = os.path.join(RUNTIME, "hypr")
    try:
        names = sorted(os.listdir(base), reverse=True,
                       key=lambda n: os.path.getmtime(os.path.join(base, n)))
    except OSError:
        return
    for name in names:
        if os.path.exists(os.path.join(base, name, ".socket.sock")):
            os.environ["HYPRLAND_INSTANCE_SIGNATURE"] = name
            if hypr_json("activeworkspace"):
                return


def for_window(address, body):
    """Lua that runs `body` (a statement using `w`) for one window only."""
    return (
        "for _, w in ipairs(hl.get_windows()) do\n"
        f"  if w.address == '{address}' then\n"
        f"    {body}\n"
        "  end\n"
        "end"
    )


def move_window(address, workspace):
    hypr_lua(for_window(
        address,
        "hl.dispatch(hl.dsp.window.move({ workspace = %s, silent = true, "
        "window = w }))" % workspace,
    ))


def focus_window(address):
    """Go to the window: switch to its workspace first, then focus it.

    Focusing alone leaves you looking at the workspace you were already on,
    so a click on a window living elsewhere appears to do nothing. The
    workspace comes off the window object, not our last refresh, so it is
    right even if the window moved a moment ago.
    """
    hypr_lua(for_window(address, """
    local ws = w.workspace
    if ws and ws.id and not ws.special then
      hl.dispatch(hl.dsp.focus({ workspace = ws.id }))
    end
    hl.dispatch(hl.dsp.focus({ window = w }))
    """.strip()))


def close_window(address):
    """Close one window.

    The object form targets the window given, unlike close("address:0x..."),
    which is accepted and then closes whatever has focus. Verified by closing
    an unfocused throwaway while a second throwaway held focus: the target
    died, the focused window lived.
    """
    hypr_lua(for_window(
        address, "hl.dispatch(hl.dsp.window.close({ window = w }))"
    ))


def lua_workspace(key):
    """Lua literal for a workspace: a number for normal, a string for special."""
    return key if isinstance(key, int) else "'special:%s'" % key


# ------------------------------------------------------------------ colors --
def palette():
    """Follow the rice's wallpaper-derived palette when there is one."""
    colors = {
        "surface": "#15130c", "surface_container": "#222017",
        "surface_container_high": "#2d2a20", "on_surface": "#e8e2d4",
        "outline": "#969180", "primary": "#d9c76f",
        "primary_container": "#534619", "on_primary_container": "#f6e48a",
        "error": "#ffb4ab", "tertiary": "#b0cfaa",
    }
    try:
        with open(COLORS_CONF) as handle:
            for line in handle:
                line = line.strip()
                if not line.startswith("$") or "rgba(" not in line:
                    continue
                name, _, value = line[1:].partition("=")
                digits = value.strip()[5:-1]
                if len(digits) >= 6:
                    colors[name.strip()] = "#" + digits[:6]
    except OSError:
        pass
    return colors


