#!/usr/bin/env python3
"""hypr-windows - an on-screen window map and dock for Hyprland 0.57.

Every open window, grouped by the workspace it sits on. Click a window to go
to it, drag it onto another workspace to move it, press its X to close it,
and the top line always names the window that currently has focus.

It can live on any edge, either locked open as a dock that reserves its strip
or popping in from the edge when the pointer touches it.

Hyprland 0.57's dispatchers are Lua and only honour a window *object*:
"address:0x..." as a string either fails to parse or - for close - is accepted
and acted on whatever window has focus, which is how an unrelated browser
window once died here. So every action goes through `hyprctl eval` with a loop
over hl.get_windows() matched on w.address, the one form that reliably targets
the window you meant.
"""

import os
import sys

# gtk4-layer-shell has to be loaded before libwayland-client, which a script
# cannot arrange at link time. Re-exec once with it preloaded, or the window
# comes up as an ordinary toplevel instead of a dock.
_PRELOAD = "/usr/lib/libgtk4-layer-shell.so"
if not os.environ.get("HYPR_WINDOWS_PRELOAD") and os.path.exists(_PRELOAD):
    os.environ["HYPR_WINDOWS_PRELOAD"] = "1"
    _existing = os.environ.get("LD_PRELOAD", "")
    os.environ["LD_PRELOAD"] = _PRELOAD + (":" + _existing if _existing else "")
    os.environ.setdefault("GTK_A11Y", "none")
    os.execv(sys.executable,
             [sys.executable, os.path.abspath(__file__), *sys.argv[1:]])

import colorsys  # noqa: E402
import fcntl  # noqa: E402
import json  # noqa: E402
import signal  # noqa: E402
import socket  # noqa: E402
import subprocess  # noqa: E402
import threading  # noqa: E402
import time  # noqa: E402

RUNTIME = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
PID_FILE = os.path.join(RUNTIME, "hypr-windows.pid")
LOCK_FILE = os.path.join(RUNTIME, "hypr-windows.lock")
CONFIG_DIR = os.path.expanduser("~/.config/hypr-windows")
CONFIG_FILE = os.path.join(CONFIG_DIR, "config.json")


def claim_singleton():
    """Hold an exclusive lock for as long as this instance lives.

    A PID file alone loses a race: GTK takes about a second to come up, so
    two clicks inside that window both find no PID file and both start. The
    lock is taken here, before the GTK import, so the second one always
    loses. It is dropped automatically when the process exits, and released
    across the re-exec a settings change does (the fd is close-on-exec),
    which is why the new image can take it straight back.
    """
    handle = open(LOCK_FILE, "a+")
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return handle
    except OSError:
        handle.close()
        return None


def signal_running(sig):
    try:
        with open(PID_FILE) as handle:
            pid = int(handle.read().split()[0])
        if pid != os.getpid():
            os.kill(pid, sig)
    except (OSError, ValueError):
        pass


if "--help" not in sys.argv and "-h" not in sys.argv:
    _LOCK = claim_singleton()
    if _LOCK is None:
        # Somebody is already up. A plain launch toggles them - quitting a
        # locked dock, sliding a pop-in one - and --no-toggle just leaves.
        if "--no-toggle" not in sys.argv:
            # The running instance records the mode it is actually in on the
            # second line of its PID file, which is what matters here: a flag
            # override means the stored config can say something else.
            locked = True
            try:
                with open(PID_FILE) as handle:
                    lines = handle.read().split()
                locked = lines[1] != "pop-in"
            except (OSError, IndexError):
                try:
                    with open(CONFIG_FILE) as handle:
                        locked = bool(json.load(handle).get("locked", True))
                except (OSError, ValueError):
                    pass
            signal_running(signal.SIGTERM if locked else signal.SIGUSR1)
        sys.exit(0)

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import hypr_devices  # noqa: E402

# How long a just-ejected drive is believed over any listing of the devices.
# udisks takes a moment to drop the drive and the kernel longer still to
# remove the node, and a refresh that started before the eject lands inside
# that window with the old answer.
EJECT_GRACE = 8.0

